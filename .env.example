# Application
APP_NAME=Boxing Management API
ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database (Postgres in prod; SQLite ok for local tests via DATABASE_URL)
DATABASE_URL=postgresql+psycopg://boxing:boxing@localhost:5432/boxing
# Or discrete vars (used if DATABASE_URL unset):
POSTGRES_USER=boxing
POSTGRES_PASSWORD=change-me
POSTGRES_DB=boxing
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# CORS — comma-separated origins (never use * in production)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CALLS=100
RATE_LIMIT_PERIOD=60

# Stripe (Checkout + webhooks) — placeholders only
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_SUCCESS_URL=http://localhost:3000/payments/success
STRIPE_CANCEL_URL=http://localhost:3000/payments/cancel
# Optional subscription price id stub
STRIPE_SUBSCRIPTION_PRICE_ID=price_replace_me

# Optional Redis (not required for core API / in-memory rate limit)
# REDIS_URL=redis://localhost:6379/0

# Public API base URL (for webhook docs / Stripe Dashboard)
PUBLIC_BASE_URL=http://localhost:8000
